{
  "listen": "127.0.0.1:8765",
  "history_limit": 250,
  "youtube": {
    "enabled": false,
    "live_chat_id": "",
    "video_id": "YOUR_LIVE_VIDEO_ID",
    "oauth_token_env": "MULTICHAT_YOUTUBE_OAUTH_TOKEN",
    "api_key_env": "MULTICHAT_YOUTUBE_API_KEY",
    "poll_seconds": 20,
    "daily_quota_units": 6000,
    "use_saved_google_auth": false
  },
  "tiktok": {
    "enabled": false,
    "username": "YOUR_TIKTOK_USERNAME"
  },
  "twitch": {
    "enabled": false,
    "channel": "YOUR_TWITCH_CHANNEL",
    "nick": "YOUR_BOT_USERNAME",
    "token_env": "MULTICHAT_TWITCH_TOKEN",
    "use_saved_twitch_auth": false
  },
  "kick": {
    "enabled": false,
    "channel": "YOUR_KICK_CHANNEL",
    "chatroom_id": ""
  },
  "facebook": {
    "enabled": false,
    "live_video_id": "FACEBOOK_LIVE_VIDEO_NUMERIC_ID",
    "page_id": "",
    "access_token_env": "MULTICHAT_FACEBOOK_PAGE_TOKEN",
    "poll_seconds": 10
  },
  "rumble": {
    "enabled": false,
    "api_url_env": "MULTICHAT_RUMBLE_API_URL",
    "poll_seconds": 15
  },
  "ingest": {
    "enabled": false,
    "token_env": "MULTICHAT_INGEST_TOKEN"
  },
  "panel_auth": {
    "enabled": false,
    "token_env": "MULTICHAT_PANEL_TOKEN",
    "obs_token_env": "MULTICHAT_OBS_TOKEN",
    "native_token_env": "MULTICHAT_NATIVE_TOKEN"
  },
  "outbound": {
    "enabled": false,
    "kick_token_env": "MULTICHAT_KICK_CHAT_WRITE_TOKEN",
    "kick_broadcaster_user_id": 0
  },
  "obs": {
    "enabled": false,
    "token_env": "MULTICHAT_OBS_EVENT_TOKEN",
    "start_collectors_on_stream": true,
    "scan_all_configured": false,
    "websocket_enabled": false,
    "websocket_port": 4455,
    "websocket_password_env": "MULTICHAT_OBS_WS_PASSWORD"
  }
}
