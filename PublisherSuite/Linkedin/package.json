{
  "name": "@solarispkn/linkedin-publisher",
  "version": "0.1.0",
  "private": true,
  "description": "Conversor local y seguro de Markdown/MDX a contenido listo para LinkedIn Articles.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && node scripts/server.mjs",
    "serve": "node scripts/server.mjs",
    "convert": "node scripts/convert.mjs",
    "test": "node --test",
    "check": "npm run test && npm run build"
  },
  "dependencies": {
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.9"
  }
}
